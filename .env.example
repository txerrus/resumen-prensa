# === Copia este archivo a ".env" y rellena tus valores reales ===
# (El archivo .env NO debe compartirse ni subirse a ningún sitio)

# Clave de API de Claude (https://console.anthropic.com/ -> API Keys)
ANTHROPIC_API_KEY=sk-ant-...

# Modelo de Claude a usar para el resumen
ANTHROPIC_MODEL=claude-sonnet-5-5

# --- Envío de correo por Gmail (SMTP) ---
# Tu dirección de Gmail
GMAIL_USER=txerrus@gmail.com
# Contraseña de APLICACIÓN de Gmail (16 letras), NO tu contraseña normal.
# Se crea en: Cuenta de Google -> Seguridad -> Verificación en 2 pasos -> Contraseñas de aplicaciones
GMAIL_APP_PASSWORD=xxxxxxxxxxxxxxxx

# A quién se envía el resumen (puede ser tu mismo correo)
MAIL_TO=txerrus@gmail.com

# Enlace a la página de preguntas (se rellenará cuando la publiquemos)
QA_URL=
